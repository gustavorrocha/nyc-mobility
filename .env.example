# Copie para .env (ignorado pelo Git) e troque os valores.
# Use senhas sem caracteres especiais de URL (@ : / ? # %), pois compõem a conexão do Airflow.
POSTGRES_USER=nyc
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=nyc_mobility

# Segredo compartilhado entre os componentes do Airflow 3 (gere com: python -c "import secrets; print(secrets.token_urlsafe(32))")
AIRFLOW_JWT_SECRET=troque-este-segredo

# Senha do usuário somente leitura do dashboard (dashboard_reader), aplicada por `nyc-mobility db upgrade`
DASHBOARD_DB_PASSWORD=troque-esta-senha-de-leitura

# Opcionais: portas publicadas no host (apenas 127.0.0.1)
# POSTGRES_HOST_PORT=5432
# AIRFLOW_HOST_PORT=8080
# DASHBOARD_HOST_PORT=8050
# AIRFLOW_UID=50000
